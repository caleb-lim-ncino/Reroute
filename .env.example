# TfL Unified API. Unauthenticated tier works for light testing; set this for higher rate limits.
TFL_APP_KEY=

# AWS auth for Bedrock — provide EITHER AWS_PROFILE (SSO) OR the key trio below, not both required.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Bedrock application-inference-profile ARN for the verdict model.
VERDICT_MODEL_ID=

# Cost tracking (USD per million tokens).
RATE_INPUT_PER_MTOK=1.00
RATE_OUTPUT_PER_MTOK=5.00

# Server
PORT=3000
